import MacOS::{ GetStdHandle, StdHandle, WriteFile, ReadFile, GetProcessHeap, HeapAlloc, HeapFree, Munmap };

// Exercises the macOS bindings end-to-end: a non-zero exit code identifies the
// step that failed; 0 means every binding behaved as expected.
func Main() -> int32 {
    // stdout via WriteFile
    let msg = c8"MacOS smoke: stdout via WriteFile\n";
    let handle = GetStdHandle(StdHandle::Output);
    var written: uint32 = 0;
    if WriteFile(handle, msg.data, msg.length as uint32, &written, null) == 0 {
        return 1i32;
    }
    if written != msg.length as uint32 {
        return 2i32;
    }

    // heap: allocate, write, read back, free
    let heap = GetProcessHeap();
    let buf = HeapAlloc(heap, 0u32, 32u) as *char8;
    if buf == null {
        return 3i32;
    }
    *buf = c8'R';
    *(buf + 1u) = c8'X';
    if *buf != c8'R' || *(buf + 1u) != c8'X' {
        return 4i32;
    }
    if HeapFree(heap, 0u32, buf as *opaque) == 0 {
        return 5i32;
    }

    // stdin via ReadFile. A failed call is an error; zero bytes (EOF / no piped
    // input) is acceptable so the smoke bin still passes when run without stdin.
    var input: char8[32];
    var bytesRead: uint32 = 0;
    let stdin = GetStdHandle(StdHandle::Input);
    if ReadFile(stdin, input.data, input.length as uint32, &bytesRead, null) == 0 {
        return 6i32;
    }

    // mmap/munmap roundtrip: allocate a page, write/read, then unmap it.
    let page = HeapAlloc(heap, 0u32, 4096u) as *char8;
    if page == null {
        return 7i32;
    }
    *page = c8'M';
    if *page != c8'M' {
        return 8i32;
    }
    if Munmap(page as *opaque, 4096u) != 0i64 {
        return 9i32;
    }

    return 0i32;
}
